<?xml version="1.0" encoding="UTF-8"?>
<!ELEMENT businesscard (card)>
<!ELEMENT card (identity, role, contact, branding)>

<!-- Why not combine businesscard and card? -->

  <!ELEMENT identity (name, company)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT company (#PCDATA)>

  <!ELEMENT role (title)>

<!-- maybe could be more than one title? title+ -->
  <!ELEMENT title (#PCDATA)>

  <!ELEMENT contact (email, phone, website)>
  <!ELEMENT email (#PCDATA)>
  <!ELEMENT phone (#PCDATA)>
  <!ELEMENT website (#PCDATA)>

  <!ELEMENT branding (logo, colourscheme)>
  <!ELEMENT logo (#PCDATA)>

<!-- could be zero or more instances of a logo? logo* -->

<!-- colourscheme is an element that needs definition -->
]>
